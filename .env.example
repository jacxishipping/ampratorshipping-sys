# Database - REQUIRED: Use these exact variable names

# Prisma Accelerate URL — used by the app at RUNTIME (connection pooling via Prisma Accelerate)
# Format: prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE
jacxi_PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE"

# Direct PostgreSQL connection — used by Prisma Migrate (CLI only, bypasses Accelerate)
# Format: postgres://user:password@db.prisma.io:5432/postgres?sslmode=require
jacxi_POSTGRES_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# Direct PostgreSQL connection — legacy / backward compatibility with scripts
jacxi_DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# Authentication
# IMPORTANT: NEXTAUTH_SECRET must be a secure random string (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-here"
# NEXTAUTH_URL must match your deployment URL for cookies to work properly
# For local development: http://localhost:3000
# For production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Email Service (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# AI Provider (Dashboard-managed)
# Configure API key, endpoint URL, and model in Dashboard > Settings > AI.
# No AI API key environment variable is required.

# DigitalOcean AI
# Used by shipment customer update drafts. Keep this server-side only.
DO_AI_API_KEY="doo_v1_replace_with_your_rotated_token"
# Optional: override the default model if you want to switch providers/models later.
DO_AI_MODEL="openai-gpt-oss-120b"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron Job Security (for automatic tracking updates)
CRON_SECRET="your-cron-secret-here"

# Optional: Webhook Security (if using webhooks)
TRACKING_WEBHOOK_SECRET="your-webhook-secret-here"

# Preferred Copart provider: Oxylabs Web Scraper API with parsed output.
OXYLABS_DATA_API_USERNAME=""
OXYLABS_DATA_API_PASSWORD=""
OXYLABS_COPART_PARSER_PRESET="shkrcopart"

# Optional: Vercel-friendly lot-page proxy for Copart/IAAI scraping.
# Mode "connect" is for a real outbound proxy such as Oxylabs.
# Example:
# LOT_FETCH_PROXY_MODE="connect"
# LOT_FETCH_PROXY_URL="http://dc.oxylabs.io:8000"
# LOT_FETCH_PROXY_USERNAME="your-oxylabs-username"
# LOT_FETCH_PROXY_PASSWORD="your-oxylabs-password"
#
# Mode "template" is for a fetch endpoint like https://proxy.example/fetch?url={url}
LOT_FETCH_PROXY_MODE="connect"
LOT_FETCH_PROXY_URL="http://dc.oxylabs.io:8000"
LOT_FETCH_PROXY_USERNAME="your-proxy-username"
LOT_FETCH_PROXY_PASSWORD="your-proxy-password"
# Optional template-mode auth. Defaults to Authorization: Bearer <token> when token is set.
LOT_FETCH_PROXY_AUTH_TOKEN=""
LOT_FETCH_PROXY_AUTH_HEADER="authorization"
LOT_FETCH_PROXY_AUTH_SCHEME="Bearer"

# Optional: approved IAAI JSON provider, recommended when public-page fetches are blocked.
IAAI_API_URL=""
IAAI_API_KEY=""

# Voice Call Agent
# Set this on your voice provider webhook URL as /api/voice?token=YOUR_TOKEN
VOICE_WEBHOOK_TOKEN="af2aa82bc42f7e0ee05f9715ea5b745d8196211c6e3c98c5a6acf928a7f9bb90"

# Twilio API credentials and phone-number targeting are now managed from Dashboard > Settings > Call Agent.

# Gemini Call Agent settings are now managed from Dashboard > Settings > Call Agent.
