{
  "name": "jacxi-shipping",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env RUN_CUSTOM_SERVER=1 NODE_ENV=development tsx server.ts",
    "dev:turbopack": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "cross-env RUN_CUSTOM_SERVER=1 NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:web": "npm --prefix mobile run web",
    "mobile:eas:build:ios": "npm --prefix mobile run eas:build:ios",
    "mobile:eas:build:android": "npm --prefix mobile run eas:build:android",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve": "node scripts/resolve-failed-migration.js",
    "db:seed": "node scripts/init-db.js",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/backup-db.js",
    "db:backfill-notification-senders": "node scripts/backfill-notification-senders.js",
    "db:reset": "node scripts/reset-db.js",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "db:full-reset": "npm run db:reset && npm run db:seed",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:routes": "tsx --test src/app/api/workflow-routes.test.ts",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate && node scripts/fix-tanstack-react-query-types.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@napi-rs/canvas": "^0.1.80",
    "@prisma/client": "^6.18.0",
    "@react-pdf/renderer": "^4.3.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-ease": "^3.0.1",
    "driver.js": "^1.4.0",
    "gsap": "^3.15.0",
    "i18next": "^25.6.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.25",
    "next": "^16.1.6",
    "next-auth": "5.0.0-beta.31",
    "next-seo": "^7.0.1",
    "next-sitemap": "^4.2.3",
    "pdf-parse": "^2.4.5",
    "plaid": "^42.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^16.1.6",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-plaid-link": "^4.1.1",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.5.1",
    "resend": "^6.9.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tsx": "^4.22.0",
    "undici": "^6.25.0",
    "ws": "^8.20.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "prisma": "^6.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.4"
  }
}
