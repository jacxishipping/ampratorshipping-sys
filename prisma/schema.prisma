// ============================================
// DISPATCH MODELS (Origin yard → port handoff)
// ============================================

model Dispatch {
  id                String         @id @default(cuid())
  referenceNumber   String         @unique
  companyId         String
  origin            String
  destination       String
  status            DispatchStatus @default(PENDING)
  dispatchDate      DateTime?
  estimatedArrival  DateTime?
  actualArrival     DateTime?
  cost              Float?
  notes             String?
  createdBy         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company   Company           @relation(fields: [companyId], references: [id])
  shipments Shipment[]
  events    DispatchEvent[]
  expenses  DispatchExpense[]

  @@index([companyId])
  @@index([status])
}

model DispatchEvent {
  id          String   @id @default(cuid())
  dispatchId  String
  status      String
  location    String?
  description String?
  eventDate   DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([dispatchId])
  @@index([eventDate])
}

model DispatchExpense {
  id            String   @id @default(cuid())
  dispatchId    String
  shipmentId    String?
  type          String   @default("OTHER")
  description   String
  amount        Float
  currency      String   @default("USD")
  date          DateTime @default(now())
  vendor        String?
  invoiceNumber String?
  category      String?
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dispatch Dispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([dispatchId])
  @@index([shipmentId])
  @@index([type])
}

// ============================================
// TRANSIT MODELS (UAE → Afghanistan delivery)
// ============================================

model Transit {
  id                String        @id @default(cuid())
  referenceNumber   String        @unique
  companyId         String?
  origin            String        @default("Dubai, UAE")
  destination       String        @default("Kabul, Afghanistan")
  status            TransitStatus @default(PENDING)
  dispatchDate      DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  deliveryReceiverName String?
  deliveryProofUrl  String?
  deliveryProofName String?
  deliveryProofType String?
  deliveryNotes     String?
  cost              Float? // Agreed transit cost
  notes             String?
  createdBy         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company   Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  shipments Shipment[]
  events    TransitEvent[]
  expenses  TransitExpense[]

  @@index([companyId])
  @@index([status])
}

model TransitEvent {
  id          String   @id @default(cuid())
  transitId   String
  companyId   String
  origin      String
  destination String
  status      String
  location    String?
  description String?
  eventDate   DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())

  transit Transit @relation(fields: [transitId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  expenses TransitExpense[]

  @@index([transitId])
  @@index([companyId])
  @@index([eventDate])
}

model TransitExpense {
  id            String   @id @default(cuid())
  transitId     String
  transitEventId String?
  shipmentId    String?
  type          String   @default("OTHER")
  description   String
  amount        Float
  currency      String   @default("USD")
  date          DateTime @default(now())
  vendor        String?
  invoiceNumber String?
  category      String?
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transit  Transit   @relation(fields: [transitId], references: [id], onDelete: Cascade)
  transitEvent TransitEvent? @relation(fields: [transitEventId], references: [id], onDelete: SetNull)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([transitId])
  @@index([transitEventId])
  @@index([shipmentId])
  @@index([type])
}

model AuditLog {
  id          String       @id @default(cuid())
  entityType  String
  entityId    String
  action      AuditAction
  performedBy String
  performedAt DateTime     @default(now())
  changes     Json?
  ipAddress   String?
  userAgent   String?
  ledgerEntry LedgerEntry? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([performedAt])
}

