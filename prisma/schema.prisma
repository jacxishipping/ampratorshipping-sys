// ============================================
// RATE LIMIT MODEL (Security)
// ============================================

model RateLimit {
  id         String   @id @default(cuid())
  identifier String   @unique // IP address or other identifier
  count      Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// ============================================
// PHASE 3: FX RATE + BANK RECONCILIATION MODELS
// ============================================

/// Snapshot of a currency exchange rate, so invoices can store the exact rate
/// used at the time of calculation (no silent re-pricing on report day).
model ExchangeRate {
  id        String   @id @default(cuid())
  base      String   @default("USD")
  currency  String
  rate      Float    // 1 base currency = `rate` of `currency`
  source    String   @default("MANUAL") // MANUAL | EXCHANGERATE_API | OPENEXCHANGERATES | FIXED
  effective DateTime @default(now())
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([currency, effective])
  @@index([currency])
  @@index([effective])
}

/// Per-row reconciliation between an imported bank transaction and the ledger
/// entry it was matched to. Replaces the previous "metadata-only" convention.
model BankReconciliation {
  id          String  @id @default(cuid())
  bankSource  String // PLAIN | PLIAD | FINICITY | BOA_CSV
  sourceKey   String // plaidTransactionId | finicityCustomerId:accountId:transactionId | sha256 fingerprint
  ledgerEntryId String?
  invoiceId   String?
  matchedAt   DateTime?
  matchedBy   String? // user who confirmed the match
  status      String  @default("UNMATCHED") // UNMATCHED | MATCHED | DISPUTED | IGNORED
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ledgerEntry LedgerEntry?  @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  invoice     UserInvoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([bankSource, sourceKey])
  @@index([ledgerEntryId])
  @@index([invoiceId])
  @@index([status])
}
