// This is the NEW schema for Container System Restructure
// ⚠️ This will REPLACE the current schema.prisma after review
// This implements the complete container-first architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTHENTICATION MODELS (Unchanged)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  loginCode     String?        @unique // Simple 8-character login code for easy access
  role          String         @default("user")
  phone         String?
  address       String?
  city          String?
  country       String?
  collectionStatus CollectionStatus @default(CURRENT)
  promiseToPayDate DateTime?
  collectionFollowUpDate DateTime?
  collectionNotes String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  documents     Document[]
  payments      Payment[]
  quotes        Quote[]
  sessions      Session[]
  shipments     Shipment[]
  settings      UserSettings?
  ledgerEntries LedgerEntry[]
  invoices      UserInvoice[]
  shipmentCharges ShipmentCharge[]
  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications     Notification[] @relation("NotificationSender")
  partnerPortalMemberships PartnerPortalMembership[]
  plaidItems     PlaidItem[]

  @@index([loginCode])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// NOTIFICATION MODEL (New)
// ============================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  senderId    String?
  title       String
  description String
  type        NotificationType @default(INFO)
  read        Boolean          @default(false)
  link        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sender      User?            @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([senderId])
  @@index([read])
  @@index([createdAt])
}

// ============================================
// SHIPMENT MODEL (Simplified - Car Info Only)
// ============================================

model Shipment {
  id String @id @default(cuid())

  // Service Type - NEW: Differentiates between purchase+shipping vs shipping-only
  serviceType ServiceType @default(SHIPPING_ONLY)

  // Vehicle Information
  vehicleType    String
  vehicleMake    String?
  vehicleModel   String?
  vehicleYear    Int?
  vehicleVIN     String?      @unique
  vehicleColor   String?
  lotNumber      String?
  auctionName    String?
  hasKey         Boolean?
  hasTitle       Boolean?
  titleStatus    TitleStatus?
  vehicleAge     Int?
  weight         Float?
  dimensions     String?
  insuranceValue Float?
  arrivalPhotos  String[]     @default([])
  vehiclePhotos  String[]     @default([])

  // Purchase Information - NEW: Only applicable for PURCHASE_AND_SHIPPING service type
  purchasePrice    Float? // Vehicle purchase price (when company buys for customer)
  purchaseDate     DateTime? // Date vehicle was purchased
  purchaseLocation String? // Auction/Dealer location
  dealerName       String? // Dealer or auction house name
  purchaseNotes    String? // Additional purchase details

  // Status and Assignment
  status        ShipmentSimpleStatus @default(ON_HAND)
  dispatchId    String?
  containerId   String?
  transitId     String?
  shippingCompanyId String?
  userId        String // Owner/Customer
  internalNotes String?

  // Financial (shipping service price)
  price              Float? // Customer shipping fare (separate from purchase price)
  companyShippingFare Float? // Internal company shipping cost
  priceListPricingSnapshot Json?
  
  // Damage Tracking
  damageCost    Float? // Cost of damage charged to company (company ledger debit)
  damageCredit  Float? // Credit given to customer for damage assumed by company (user ledger credit)
  
  paymentStatus PaymentStatus @default(PENDING)
  paymentMode   PaymentMode?
  releaseToken  String?       @unique
  releaseTokenCreatedAt DateTime?
  companyGetpassStartedAt DateTime?
  companyGetpassCompletedAt DateTime?
  companyGetpassDurationSeconds Int?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dispatch         Dispatch?         @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  container        Container?        @relation(fields: [containerId], references: [id], onDelete: SetNull)
  transit          Transit?          @relation(fields: [transitId], references: [id], onDelete: SetNull)
  shippingCompany  Company?          @relation("ShipmentShippingCompany", fields: [shippingCompanyId], references: [id], onDelete: SetNull)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        Document[]
  payments         Payment[]
  qualityChecks    QualityCheck[]
  ledgerEntries    LedgerEntry[]
  invoiceLineItems InvoiceLineItem[]
  invoices         UserInvoice[]     @relation("ShipmentInvoice")
  dispatchExpenses DispatchExpense[]
  transitExpenses  TransitExpense[]
  containerDamages ContainerDamage[]
  auditLogs        ShipmentAuditLog[]
  charges          ShipmentCharge[]
  partnerPortalAssignment PartnerShipmentAssignment?
  partnerPortalLedgerEntries PartnerPortalLedgerEntry[]
  partnerPortalPaymentRecords PartnerPortalPaymentRecord[]

  @@index([userId])
  @@index([dispatchId])
  @@index([containerId])
  @@index([transitId])
  @@index([shippingCompanyId])
  @@index([status])
  @@index([vehicleVIN])
  @@index([serviceType])
  @@index([createdAt]) // ⚡ Bolt: Added index to optimize frequent sorting by createdAt
}

// ============================================
// CONTAINER MODEL (Primary Shipping Unit)
// ============================================

model Container {
  id              String @id @default(cuid())
  containerNumber String @unique
  companyId       String?

  // Shipping Information
  trackingNumber String? @unique
  vesselName     String?
  voyageNumber   String?
  shippingLine   String?
  bookingNumber  String?

  // Ports
  loadingPort        String?
  destinationPort    String?
  transshipmentPorts String[] @default([])

  // Dates
  loadingDate      DateTime?
  departureDate    DateTime?
  estimatedArrival DateTime?
  actualArrival    DateTime?

  // Status and Progress
  status          ContainerLifecycleStatus @default(CREATED)
  currentLocation String?
  progress        Int                      @default(0)

  // Capacity
  maxCapacity  Int @default(4)
  currentCount Int @default(0)

  // Notes and Documentation
  notes               String?
  lastLocationUpdate  DateTime?
  autoTrackingEnabled Boolean   @default(true)

  // Expense Allocation
  expenseAllocationMethod ExpenseAllocationMethod @default(EQUAL)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  shipments      Shipment[]
  expenses       ContainerExpense[]
  damages        ContainerDamage[]
  invoices       ContainerInvoice[]
  documents      ContainerDocument[]
  trackingEvents ContainerTrackingEvent[]
  auditLogs      ContainerAuditLog[]
  userInvoices   UserInvoice[]

  @@index([status])
  @@index([companyId])
  @@index([shippingLine])
  @@index([destinationPort])
  @@index([estimatedArrival])
  @@index([trackingNumber])
  @@index([createdAt]) // ⚡ Bolt: Added index to optimize frequent sorting by createdAt
}

// ============================================
// CONTAINER SUB-MODELS
// ============================================

model ContainerExpense {
  id            String   @id @default(cuid())
  containerId   String
  type          String // Shipping, Customs, Storage, Handling, etc.
  amount        Float
  currency      String   @default("USD")
  date          DateTime @default(now())
  vendor        String?
  invoiceNumber String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId])
  @@index([type])
}

model ContainerDamage {
  id          String     @id @default(cuid())
  containerId String
  shipmentId  String
  damageType  DamageType
  amount      Float
  description String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([containerId])
  @@index([shipmentId])
  @@index([damageType])
}

model ContainerInvoice {
  id            String        @id @default(cuid())
  containerId   String
  invoiceNumber String
  amount        Float
  currency      String        @default("USD")
  vendor        String?
  date          DateTime
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)
  fileUrl       String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId])
  @@index([status])
}

model ContainerDocument {
  id          String   @id @default(cuid())
  containerId String
  type        String // BOL, Customs, Packing_List, Photos, Export_Docs, etc.
  name        String
  fileUrl     String
  fileType    String
  fileSize    Int
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  notes       String?

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId])
  @@index([type])
}

model ContainerTrackingEvent {
  id          String   @id @default(cuid())
  containerId String
  status      String
  location    String?
  vesselName  String?
  description String?
  eventDate   DateTime
  source      String? // API, Manual, System
  completed   Boolean  @default(false)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId])
  @@index([eventDate])
}

model ContainerAuditLog {
  id          String   @id @default(cuid())
  containerId String
  action      String // Status_Change, Shipment_Added, ETA_Updated, Expense_Added, etc.
  description String
  performedBy String
  oldValue    String?
  newValue    String?
  metadata    Json?
  timestamp   DateTime @default(now())

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId])
  @@index([timestamp])
  @@index([action])
}

model ShipmentAuditLog {
  id          String   @id @default(cuid())
  shipmentId  String
  action      String
  description String
  performedBy String
  oldValue    String?
  newValue    String?
  metadata    Json?
  timestamp   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([timestamp])
  @@index([action])
}

// ============================================
// OTHER MODELS (Mostly Unchanged)
// ============================================

model Quote {
  id           String      @id @default(cuid())
  userId       String?
  vehicleType  String?
  vehicleMake  String?
  vehicleModel String?
  vehicleYear  Int?
  origin       String?
  destination  String?
  price        Float?
  status       QuoteStatus @default(PENDING)
  validUntil   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  email        String
  message      String
  name         String
  phone        String
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  shipmentId    String
  invoiceId     String?
  amount        Float
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  transactionId String?
  gateway       String?
  idempotencyKey String?      @unique
  refundedAt    DateTime?
  refundReason  String?
  refundOfPaymentId String?   // Self-reference for refund payments
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shipment      Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice       UserInvoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  allocations   PaymentAllocation[]

  @@index([userId])
  @@index([shipmentId])
  @@index([invoiceId])
  @@index([status])
}

/// Tracks how a single Payment is allocated across one or more invoices.
/// Replaces the previous convention of storing `shipmentIds` in Payment.metadata
/// without a schema-enforced link to UserInvoice.
model PaymentAllocation {
  id           String    @id @default(cuid())
  paymentId    String
  invoiceId    String
  /// Amount of this payment applied to this invoice.
  amount       Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payment      Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      UserInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
  @@unique([paymentId, invoiceId])
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  theme               String   @default("futuristic")
  accentColor         String   @default("#00BFFF")
  sidebarDensity      String   @default("comfortable")
  animationsEnabled   Boolean  @default(true)
  notifyShipmentEmail Boolean  @default(true)
  notifyShipmentPush  Boolean  @default(true)
  notifyPaymentEmail  Boolean  @default(true)
  notifyCriticalSms   Boolean  @default(false)
  twoFactorEnabled    Boolean  @default(false)
  language            String   @default("en")
  calculatorConfig    Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CallAgentSettings {
  id                   String   @id @default(cuid())
  scope                String   @unique @default("default")
  twilioAccountSid     String?
  twilioAuthToken      String?
  twilioApiKey         String?
  twilioApiSecret      String?
  twilioPhoneNumber    String?
  twilioPhoneNumberSid String?
  geminiApiKey         String?
  geminiLiveApiKey     String?
  geminiVoiceModel     String?
  geminiLiveModel      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AiProviderSettings {
  id                 String   @id @default(cuid())
  scope              String   @unique @default("default")
  enabled            Boolean  @default(true)
  provider           String   @default("tokenrouter-ai")
  apiKey             String?
  chatCompletionsUrl String?
  modelsUrl          String?
  model              String?
  maxTokens          Int      @default(500)
  temperature        Float    @default(0.3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CommunicationProviderSettings {
  id                    String   @id @default(cuid())
  scope                 String   @unique @default("default")
  emailEnabled          Boolean  @default(false)
  emailProvider         String   @default("resend")
  emailApiKey           String?
  emailFromAddress      String?
  emailReplyToAddress   String?
  smsEnabled            Boolean  @default(false)
  smsProvider           String   @default("twilio")
  smsAccountSid         String?
  smsAuthToken          String?
  smsFromNumber         String?
  smsMessagingServiceSid String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Newsletter {
  id        String           @id @default(cuid())
  email     String           @unique
  status    NewsletterStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String
  excerpt       String?
  featuredImage String?
  author        String
  published     Boolean   @default(false)
  publishedAt   DateTime?
  tags          String[]
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Testimonial {
  id        String            @id @default(cuid())
  name      String
  location  String
  rating    Int
  content   String
  image     String?
  featured  Boolean           @default(false)
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model QualityCheck {
  id         String             @id @default(cuid())
  shipmentId String
  checkType  QualityCheckType
  status     QualityCheckStatus @default(PENDING)
  inspector  String?
  notes      String?
  photos     String[]           @default([])
  checkedAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  shipment   Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Document {
  id          String           @id @default(cuid())
  name        String
  description String?
  fileUrl     String
  fileType    String
  fileSize    Int
  category    DocumentCategory
  shipmentId  String?
  userId      String?
  uploadedBy  String
  isPublic    Boolean          @default(false)
  tags        String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  shipment    Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Route {
  id            String      @id @default(cuid())
  name          String
  origin        String
  destination   String
  waypoints     Json[]      @default([])
  distance      Float?
  estimatedTime Int?
  cost          Float?
  status        RouteStatus @default(ACTIVE)
  preferences   Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ============================================
// USER INVOICE MODELS (Customer Invoicing)
// ============================================

model UserInvoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique // INV-2025-001
  userId        String
  containerId   String? // Optional: container-level invoices
  shipmentId    String? // Per-shipment invoice (auto-created on shipment creation)
  // Invoice Details
  status    UserInvoiceStatus @default(PENDING)
  issueDate DateTime          @default(now())
  dueDate   DateTime?
  paidDate  DateTime?

  // Amounts
  subtotal Float // Sum of all line items
  tax      Float @default(0)
  discount Float @default(0)
  total    Float
  // Partial-payment tracking
  amountPaid      Float @default(0)
  amountRemaining Float

  // Reversal / void tracking
  voidedAt      DateTime?
  voidedReason  String?
  reversedInvoiceId String? // If this is a credit-note reversal, the original invoice it offsets

  // Reminder tracking (Phase 2)
  lastReminderAt DateTime?
  lastReminderDaysAgo Int?

  // Payment
  paymentMethod    String?
  paymentReference String?

  // Phase 3: FX snapshot so a foreign-currency invoice preserves the exact rate
  // used at issue time (no silent re-pricing on report day).
  currency    String  @default("USD")
  fxRate      Float? // 1 base currency = fxRate of `currency`; null when USD
  fxEffective DateTime?

  // Notes
  notes         String?
  internalNotes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  container Container?        @relation(fields: [containerId], references: [id], onDelete: SetNull)
  shipment  Shipment?         @relation("ShipmentInvoice", fields: [shipmentId], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]
  auditLogs InvoiceAuditLog[]
  shipmentCharges ShipmentCharge[]
  payments  Payment[]
  allocations PaymentAllocation[]
  bankReconciliations BankReconciliation[]

  @@index([userId])
  @@index([containerId])
  @@index([shipmentId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([issueDate])
  @@index([dueDate])
  @@index([createdAt]) // ⚡ Bolt: Added index to optimize frequent sorting by createdAt
  @@index([userId, status, dueDate]) // AR-aging composite index
}

model PlaidItem {
  id                    String                   @id @default(cuid())
  userId                String
  itemId                String                   @unique
  accessTokenCiphertext String
  institutionId         String?
  institutionName       String?
  lastCursor            String?
  lastSyncAt            DateTime?
  selectedAccounts      Json?
  status                String                   @default("ACTIVE")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncedTransactions    PlaidSyncedTransaction[]

  @@index([userId])
  @@index([status])
}

model PlaidSyncedTransaction {
  id                 String    @id @default(cuid())
  plaidItemId        String
  plaidTransactionId String    @unique
  accountId          String
  ledgerEntryId      String?
  isRemoved          Boolean   @default(false)
  transactionDate    DateTime
  amount             Float
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  plaidItem          PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@index([plaidItemId])
  @@index([ledgerEntryId])
  @@index([isRemoved])
}

model ShipmentCharge {
  id               String                   @id @default(cuid())
  shipmentId       String
  userId           String
  invoiceId        String?
  chargeCode       String
  category         ShipmentChargeCategory
  billingMilestone ShipmentBillingMilestone
  sourceType       ShipmentChargeSourceType
  sourceId         String?
  description      String
  quantity         Float                    @default(1)
  unitAmount       Float
  totalAmount      Float
  currency         String                   @default("USD")
  status           ShipmentChargeStatus     @default(DRAFT)
  billableAt       DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  invoicedAt       DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  notes            String?
  metadata         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  shipment  Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice   UserInvoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  auditLogs ShipmentChargeAuditLog[]
  lineItems InvoiceLineItem[]

  @@index([shipmentId])
  @@index([userId])
  @@index([invoiceId])
  @@index([status])
  @@index([category])
  @@index([billingMilestone])
  @@index([sourceType, sourceId])
  @@index([billableAt])
  @@index([createdAt])
}

model ShipmentChargeAuditLog {
  id          String   @id @default(cuid())
  chargeId     String
  action      String
  description String
  performedBy String
  oldValue    String?
  newValue    String?
  metadata    Json?
  timestamp   DateTime @default(now())

  charge ShipmentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@index([timestamp])
  @@index([action])
}

model InvoiceAuditLog {
  id          String   @id @default(cuid())
  invoiceId    String
  action      String
  description String
  performedBy String
  oldValue    String?
  newValue    String?
  metadata    Json?
  timestamp   DateTime @default(now())

  invoice UserInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([timestamp])
  @@index([action])
}

model AiInteractionLog {
  id             String   @id @default(cuid())
  feature        String
  entityType     String?
  entityId       String?
  actorUserId    String?
  provider       String
  model          String?
  prompt         String
  response       String?
  requestPayload Json?
  responsePayload Json?
  status         String   @default("SUCCESS")
  createdAt      DateTime @default(now())

  @@index([feature])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

model InvoiceLineItem {
  id        String @id @default(cuid())
  invoiceId String

  // Line Item Details
  description String // "2015 Honda Accord - Vehicle Price"
  shipmentId  String? // Link to shipment
  type        LineItemType // VEHICLE_PRICE, INSURANCE, SHARED_EXPENSE

  quantity  Float @default(1)
  unitPrice Float
  amount    Float // quantity × unitPrice
  expenseSource String?

  // Phase 3: schema-enforced link to the ShipmentCharge this line item was
  // materialised from. Replaces the previous description-string matching in
  // invoice-ledger-sync.ts.
  chargeId String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invoice  UserInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipment Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  charge   ShipmentCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([shipmentId])
  @@index([type])
  @@index([expenseSource])
  @@index([chargeId])
}

// ============================================
// FINANCIAL MODELS (From Accounting System)
// ============================================

model LedgerEntry {
  id              String          @id @default(cuid())
  userId          String
  shipmentId      String?
  transactionDate DateTime        @default(now())
  description     String
  type            LedgerEntryType
  transactionInfoType TransactionInfoType?
  amount          Float
  balance         Float
  createdBy       String
  notes           String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipment        Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  auditLogs       AuditLog[]
  bankReconciliations BankReconciliation[]

  @@index([userId])
  @@index([shipmentId])
  @@index([transactionDate])
  @@index([transactionInfoType])
}

model Company {
  id            String               @id @default(cuid())
  name          String
  code          String?              @unique
  email         String?
  phone         String?
  address       String?
  country       String?
  notes         String?
  companyType   CompanyType          @default(SHIPPING) // Kept for backward compat
  isDispatch    Boolean              @default(false)
  isShipping    Boolean              @default(false)
  isTransit     Boolean              @default(false)
  isActive      Boolean              @default(true)
  priceListConfig Json                @default("{}")
  createdBy     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  ledgerEntries CompanyLedgerEntry[]
  priceLists    CompanyPriceList[]
  dispatches    Dispatch[]
  transits      Transit[]
  transitEvents TransitEvent[]
  shipments     Shipment[]           @relation("ShipmentShippingCompany")
  containers    Container[]

  @@index([name])
  @@index([isActive])
  @@index([companyType])
}

model CompanyPriceList {
  id                       String   @id @default(cuid())
  companyId                String
  name                     String
  destinationLabel         String
  sourceFileName           String
  importMode               String
  config                   Json     @default("{}")
  importedStateRateCount   Int      @default(0)
  importedAuctionRateCount Int      @default(0)
  warnings                 Json     @default("[]")
  isActive                 Boolean  @default(true)
  effectiveFrom            DateTime?
  importedBy               String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isActive])
  @@index([createdAt])
}

model CompanyLedgerEntry {
  id              String          @id @default(cuid())
  companyId       String
  transactionDate DateTime        @default(now())
  description     String
  type            LedgerEntryType
  amount          Float
  balance         Float
  category        String?
  reference       String?
  notes           String?
  metadata        Json?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([transactionDate])
  @@index([type])
}

model PartnerPortal {
  id                String                    @id @default(cuid())
  name              String
  code              String?                   @unique
  customDomain      String?                   @unique
  customDomainVerificationToken String?
  customDomainVerifiedAt DateTime?
  companyLabel      String?
  accentColor       String?
  logoUrl           String?
  notifyOnShipmentAssigned Boolean            @default(true)
  autoAssignToSingleCustomer Boolean          @default(false)
  defaultShipmentNotes String?
  requireCustomerLinkForReady Boolean         @default(true)
  notes             String?
  isActive          Boolean                   @default(true)
  createdBy         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
